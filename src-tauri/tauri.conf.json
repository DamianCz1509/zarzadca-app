{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zarzadca",
  "version": "0.16.0",
  "identifier": "pl.zarzadca.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Zarządca",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Zarządca",
    "shortDescription": "Zarządca — wspólnoty mieszkaniowe",
    "longDescription": "Aplikacja dla zarządców nieruchomości: wspólnoty, kontakty, przeglądy, umowy ze skanami, oferty, uchwały i korespondencja.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 340
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OEE2NzhDQzZFRDA4NUUKUldSZUNPM0dqR2VLdDd3NHJJR2trbTZ0Z0Vxcld5VUFSWFZaYkJpQ3VSQXFQSVZCNWltT2REUTIK",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
